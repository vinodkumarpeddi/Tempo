generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  ingestKey String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  snapshots Snapshot[]
  alerts    AlertLog[]
}

model Snapshot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fiveHourPct       Float
  fiveHourResetsAt  DateTime
  sevenDayPct       Float
  sevenDayResetsAt  DateTime
  raw               String
  capturedAt        DateTime @default(now())

  @@index([userId, capturedAt])
}

model Settings {
  id                 Int    @id @default(1)
  collectIntervalMin Int    @default(30)
  digestHourUtc      Int    @default(9) // legacy, superseded by digestHours
  digestHours        String @default("9")  // comma-separated UTC hours
  warnThreshold      Int    @default(80)
  criticalThreshold  Int    @default(95)
  adminEmail         String @default("")
  digestEnabled      Boolean @default(true)
  alertsEnabled      Boolean @default(true)
  digestFormat       String  @default("inline") // "inline" | "pdf"
  digestAudience     String  @default("all")    // "all" | "admin"
  teamKey            String  @default("")
  joinCode           String  @default("")
  lastDigestAt       DateTime?
}

model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String
  sentAt    DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
}

model BlockedEmail {
  email     String   @id
  createdAt DateTime @default(now())
}
